<?php

/**
 * Shopee Push Mechanism — CDN ACK-first relay (deploy as shopeepush.php on CDN host).
 *
 * 1) Verify platform HMAC (callback URL + raw body).
 * 2) Return HTTP 200 immediately.
 * 3) Forward raw body to aria3 POST /shopee/push/relay (async).
 *
 * Secrets live in a PHP array file outside public_html — never commit real config; chmod 600.
 * Template: doc/shopeepush-relay-config.php.example → copy beside other CDN private config.
 *
 * Requires aria3: SHOPEE_PUSH_RELAY_ENABLED=true — see doc/marketplace-webhook-cdn-relay.md
 */

declare(strict_types=1);

// Absolute path to private config (outside public_html / web root).
define('SHOPEE_PUSH_RELAY_CONFIG_FILE', '/absolute/path/outside/public_html/shopeepush-relay-config.php');

/**
 * @return array<string, string>
 */
function shopeePushRelayLoadConfig(): array
{
    if (! is_file(SHOPEE_PUSH_RELAY_CONFIG_FILE)) {
        return [];
    }

    $cfg = require SHOPEE_PUSH_RELAY_CONFIG_FILE;
    if (! is_array($cfg)) {
        return [];
    }

    $required = [
        'SHOPEE_PUSH_PARTNER_KEY',
        'SHOPEE_PUSH_CALLBACK_URL',
        'ARIA_BASE_URL',
        'ARIA_WEBHOOK_RELAY_BEARER',
    ];
    foreach ($required as $key) {
        if (! isset($cfg[$key]) || trim((string) $cfg[$key]) === '') {
            return [];
        }
    }

    /** @var array<string, string> $out */
    $out = [];
    foreach ($required as $key) {
        $out[$key] = trim((string) $cfg[$key]);
    }

    return $out;
}

header('Content-Type: text/plain; charset=utf-8');

$cfg = shopeePushRelayLoadConfig();
if ($cfg === []) {
    http_response_code(500);
    echo '';
    exit;
}

$partnerKey = $cfg['SHOPEE_PUSH_PARTNER_KEY'];
$callbackUrl = $cfg['SHOPEE_PUSH_CALLBACK_URL'];
$ariaBase = rtrim($cfg['ARIA_BASE_URL'], '/');
$relayBearer = $cfg['ARIA_WEBHOOK_RELAY_BEARER'];

$rawBody = file_get_contents('php://input') ?: '';
$platformAuth = trim((string) ($_SERVER['HTTP_AUTHORIZATION'] ?? ''));

$expected = hash_hmac('sha256', $callbackUrl.'|'.$rawBody, $partnerKey);
if ($platformAuth === '' || ! hash_equals($expected, $platformAuth)) {
    http_response_code(401);
    echo '';
    exit;
}

http_response_code(200);
echo '';

if (function_exists('fastcgi_finish_request')) {
    fastcgi_finish_request();
} else {
    if (ob_get_level() > 0) {
        ob_end_flush();
    }
    flush();
}

$relayUrl = $ariaBase.'/shopee/push/relay';

$ch = curl_init($relayUrl);
curl_setopt_array($ch, [
    CURLOPT_POST => true,
    CURLOPT_POSTFIELDS => $rawBody,
    CURLOPT_HTTPHEADER => [
        'Content-Type: application/json',
        'Authorization: Bearer '.$relayBearer,
        'X-Shopee-Push-Authorization: '.$platformAuth,
        'X-Shopee-Push-Callback-Url: '.$callbackUrl,
    ],
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_TIMEOUT => 5,
    CURLOPT_CONNECTTIMEOUT => 3,
]);

$response = curl_exec($ch);
$httpCode = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
$curlError = curl_error($ch);
curl_close($ch);

if ($httpCode < 200 || $httpCode >= 300) {
    error_log(sprintf(
        'shopeepush relay forward failed http=%d curl=%s body=%s',
        $httpCode,
        $curlError,
        is_string($response) ? substr($response, 0, 500) : ''
    ));
}