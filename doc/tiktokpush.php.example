<?php

/**
 * TikTok Shop Event API webhook — CDN ACK-first relay (deploy as tiktokpush.php in public_html).
 *
 * 1) Verify HMAC-SHA256(app_key + raw_body, app_secret) hex in Authorization.
 * 2) Return HTTP 200 immediately.
 * 3) Forward to aria3 POST /tiktok-shop/webhook/relay (async).
 *
 * Secrets: pushconfig.php outside public_html — template doc/pushconfig.php.example
 *
 * See doc/cdn-push-relay-deploy.md and doc/marketplace-webhook-cdn-relay.md
 */

declare(strict_types=1);

define('PUSH_RELAY_CONFIG_FILE', '/absolute/path/outside/public_html/pushconfig.php');

/**
 * @return array<string, string>
 */
function tiktokPushRelayLoadConfig(): array
{
    if (! is_file(PUSH_RELAY_CONFIG_FILE)) {
        return [];
    }

    $cfg = require PUSH_RELAY_CONFIG_FILE;
    if (! is_array($cfg)) {
        return [];
    }

    $required = [
        'TIKTOK_SHOP_APP_KEY',
        'TIKTOK_SHOP_APP_SECRET',
        'ARIA_BASE_URL',
        'ARIA_WEBHOOK_RELAY_BEARER',
    ];
    foreach ($required as $key) {
        if (! isset($cfg[$key]) || trim((string) $cfg[$key]) === '') {
            return [];
        }
    }

    /** @var array<string, string> $out */
    $out = [];
    foreach ($required as $key) {
        $out[$key] = trim((string) $cfg[$key]);
    }

    return $out;
}

header('Content-Type: text/plain; charset=utf-8');

$cfg = tiktokPushRelayLoadConfig();
if ($cfg === []) {
    http_response_code(500);
    echo '';
    exit;
}

$appKey = $cfg['TIKTOK_SHOP_APP_KEY'];
$appSecret = $cfg['TIKTOK_SHOP_APP_SECRET'];
$ariaBase = rtrim($cfg['ARIA_BASE_URL'], '/');
$relayBearer = $cfg['ARIA_WEBHOOK_RELAY_BEARER'];

$rawBody = file_get_contents('php://input') ?: '';
$platformAuth = trim((string) ($_SERVER['HTTP_AUTHORIZATION'] ?? ''));

$expected = hash_hmac('sha256', $appKey.$rawBody, $appSecret);
if ($platformAuth === '' || ! hash_equals($expected, $platformAuth)) {
    http_response_code(401);
    echo '';
    exit;
}

http_response_code(200);
echo '';

if (function_exists('fastcgi_finish_request')) {
    fastcgi_finish_request();
} else {
    if (ob_get_level() > 0) {
        ob_end_flush();
    }
    flush();
}

$relayUrl = $ariaBase.'/tiktok-shop/webhook/relay';

$ch = curl_init($relayUrl);
curl_setopt_array($ch, [
    CURLOPT_POST => true,
    CURLOPT_POSTFIELDS => $rawBody,
    CURLOPT_HTTPHEADER => [
        'Content-Type: application/json',
        'Authorization: Bearer '.$relayBearer,
        'X-TikTok-Shop-Authorization: '.$platformAuth,
    ],
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_TIMEOUT => 5,
    CURLOPT_CONNECTTIMEOUT => 3,
]);

$response = curl_exec($ch);
$httpCode = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
$curlError = curl_error($ch);
curl_close($ch);

if ($httpCode < 200 || $httpCode >= 300) {
    error_log(sprintf(
        'tiktokpush relay forward failed http=%d curl=%s',
        $httpCode,
        $curlError
    ));
}