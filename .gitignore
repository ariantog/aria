/.phpunit.cache
# Laravel schema dumps are loaded automatically by `migrate` before any migration
# runs, and they DROP/CREATE greenfield tables. That is destructive against the
# shared production database, so this project must never carry one.
/database/schema
/public/storage
/storage/*.key
/storage/pail
/vendor
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
public/asset/invoice-logos/*
