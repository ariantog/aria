APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# GMT+7 Indonesia — all Shopee Ads schedule times are WIB (Asia/Jakarta)
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Archive database (read-only historical data; separate MySQL DB in production)
# Initial bootstrap: mysqldump live DB → import as aria_archive → delete recent-year rows on archive.
# ARCHIVE_DB_DRIVER=mysql
# ARCHIVE_DB_HOST=127.0.0.1
# ARCHIVE_DB_PORT=3306
# ARCHIVE_DB_DATABASE=aria_archive
# ARCHIVE_DB_USERNAME=root
# ARCHIVE_DB_PASSWORD=
# DATA_RETENTION_YEARS=5

# Production MySQL (shared L10/L12 database) — auto-detected when aria_permissions exists; override if needed:
# PERMISSION_TABLE_PERMISSIONS=aria_permissions
# PERMISSION_TABLE_ROLES=aria_roles

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Jubelio integration (dormant when JUBELIO_ACTIVE=false)
JUBELIO_ACTIVE=false
JUBELIO_URL=https://api.jubelio.com/login
JUBELIO_EMAIL=
JUBELIO_PASSWORD=
JUBELIO_VERIFY_SSL=true
JUBELIO_WEBHOOK_SECRET=
# Auto-poll Jubelio for orders missed by webhooks (see jubelio:poll-missing-orders)
JUBELIO_POLL_DAYS=7
JUBELIO_TOKEN_TTL_HOURS=10
# Bot proxy (POST/GET /api/jubelio-proxy) — tokens via php artisan jubelio-proxy:client create
# JUBELIO_PROXY_MAX_PAGE_SIZE=200
# JUBELIO_PROXY_RATE_LIMIT=60
# JUBELIO_PROXY_ALLOW_WRITE=false
# Shopee Ads budget automation (web UI at /shopee-ads; enable cron task shopee-ads:process in /cron-manager)
# Schedule / daily-reset / replenish clocks use WIB (GMT+7). Override only if needed:
# SHOPEE_ADS_TIMEZONE=Asia/Jakarta
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_BASE_URL=https://partner.shopeemobile.com
# Shopee Open Platform redirect URL — COREADS / Shopee Ads app only:
SHOPEE_REDIRECT_URL=https://cdn.corenationactive.com/shopeebot.php
# STOCK CHECKER Open API (warehouse mapping / item stock — aria host):
SHOPEE_STOCK_PARTNER_ID=
SHOPEE_STOCK_PARTNER_KEY=
# SHOPEE_STOCK_BASE_URL=https://partner.shopeemobile.com
SHOPEE_STOCK_REDIRECT_URL=https://cdn.corenationactive.com/shopeestockbot.php

# CORENATION ADMIN Open API (aria3 — push + omnichannel order detail, Live Partner 2053195):
SHOPEE_ADMIN_PARTNER_ID=
SHOPEE_ADMIN_PARTNER_KEY=
# SHOPEE_ADMIN_BASE_URL=https://partner.shopeemobile.com
SHOPEE_ADMIN_REDIRECT_URL=https://cdn.corenationactive.com/shopeecoreadminbot.php

# Seller In-house Push Mechanism callback — Live Push Partner Key from Console (Push Mechanism page), NOT the Open API key.
# SHOPEE_PUSH_PARTNER_ID=   # usually same Live Partner ID as CORENATION ADMIN (2053195 on aria3)
# SHOPEE_PUSH_PARTNER_KEY=   # Live Push Partner Key only (required for webhook verify)
# Must match Open Platform callback URL exactly if URL verification fails behind a proxy:
# SHOPEE_PUSH_CALLBACK_URL=https://your-domain.example/shopee/push
# SHOPEE_PUSH_VERIFY_SIGNATURE=true
# SHOPEE_PUSH_STORE_INBOX=false
# SHOPEE_PUSH_STORE_INBOX_CODES=0,3,4
# SHOPEE_PUSH_SHADOW_ENABLED=true

# Marketplace unified webhook storage (dual-write; legacy inbox tables still used by UI until PR2)
# MARKETPLACE_WEBHOOK_UNIFIED_STORAGE=false
# MARKETPLACE_WEBHOOK_EVENTS_RETENTION_DAYS=90
# SHOPEE_PUSH_TEST_ORDERSN=220810QSK8S7BX
# TikTok Shop customer chat (mock while partner app is pending; live client is stub until credentials ship)
TIKTOK_SHOP_DRIVER=mock
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
TIKTOK_SHOP_SHOP_CIPHER=
# TIKTOK_SHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com
# TIKTOK_SHOP_ACCESS_TOKEN=
# TIKTOK_SHOP_ORDER_API_VERSION=202507
TIKTOK_SHOP_MOCK_API_TOKEN=aria-mock-tts-token
# Inbound webhooks work while DRIVER=mock (read-only inbox; no Open API writes)
TIKTOK_SHOP_WEBHOOK_ENABLED=true
TIKTOK_SHOP_WEBHOOK_VERIFY_SIGNATURE=true
TIKTOK_SHOP_WEBHOOK_STORE_INBOX=true
# Whitelist the Aria server's outbound IP in Shopee Open Platform → App list → IP Address Whitelist
# (token exchange and API calls originate from the app server, not the CDN).
# Telegram admin alerts (Shopee Ads). Use the SAME bot token as bots/bot.py OR a dedicated bot.
TELEGRAM_BOT_TOKEN=
# Private 1:1 chat: your numeric user id and sendMessage chat_id are the SAME (Python bot uses chat_id=uid).
# Set either variable below — same number. Groups need message.chat.id (negative); not your user id.
ALLOWED_TELEGRAM_USER_ID=123456789
# Optional duplicate of ALLOWED_TELEGRAM_USER_ID (merged + deduped if both set):
TELEGRAM_CHAT_IDS=

# Jubelio orders: webhook saves to jubelioorders; cron jubelio:order-jubelio-to-aria processes pending rows (see /cron-manager)
# Live-only: forward webhooks to dev (see plan/jubelio/LIVE_WEBHOOK_FORWARD.md)
# JUBELIO_DEV_WEBHOOK_URL=https://dev.example.com

# Grok read-only bulk export API (Authorization: Bearer …) — see doc/grok-readonly-api.md
# READONLY_EXPORT_BEARER_TOKEN=
# READONLY_EXPORT_USERNAME=grok

# Invoice PDF storage (written locally, served from CDN subdomain in production)
INVOICE_PATH=
INVOICE_URL=https://invoice.corenationactive.com/

# New-subdomain install — see doc/new-domain-install.md
# php artisan app:install-new-domain (or scripts/install-new-domain.sh)
# Set ARIA_LEGACY_PRODUCTION=true on the current live host so migrate+seed never runs there.
# Set ARIA_NEW_DOMAIN=true only on an empty new-subdomain DB if APP_URL still matches a legacy host.
# A Crystal production fingerprint (ledger IDs / cv-crystal) always blocks the install.
# ARIA_LEGACY_PRODUCTION=false
# ARIA_NEW_DOMAIN=false
# ARIA_LEGACY_HOSTS=aria.corenationactive.com
